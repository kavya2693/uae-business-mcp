# Password for the /admin bookings page. Leave empty to disable /admin entirely.
ADMIN_PASSWORD=

# Production storage + rate limiting (Upstash Redis, free tier is enough for a demo).
# When both are set, bookings and rate limits use Upstash. When empty, local dev uses
# a JSON file (data/bookings.json) and an in-memory rate limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional: storage driver when Upstash is not configured: "file" (default locally) or "memory".
STORAGE=file

# Optional: path to the business config (defaults to ./business.json).
BUSINESS_CONFIG=./business.json

# Optional: extra browser Origins allowed to call /mcp (comma-separated hostnames).
# Requests with no Origin header (server-to-server, e.g. Claude/ChatGPT connectors) are always allowed.
ALLOWED_ORIGINS=

# Local dev server port.
PORT=3311
